{
  "name": "nook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --sourcemap --outfile=dist-server/index.js",
    "start": "node --enable-source-maps dist-server/index.js"
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.8",
    "agora-token": "^2.0.6",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
