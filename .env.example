# Copy to .env to override the defaults. Everything except voice works locally without this file.

# Backend
PORT=3001
# Address to bind. 127.0.0.1 keeps it on this machine; 0.0.0.0 lets other devices on the network connect.
# On Render the default is 0.0.0.0 and PORT is set by Render, so neither needs setting there.
HOST=127.0.0.1
# Comma-separated frontend origins allowed to connect. Empty allows any origin, which is fine locally.
CLIENT_ORIGIN=
# Folder that holds world.json.
DATA_DIR=data

# Google sign-in. With a client id set, only signed-in people can build rooms; without it,
# everyone can and rooms belong to the browser that made them.
GOOGLE_CLIENT_ID=
# Any random string of 32 or more characters. It signs login sessions, so keep it secret
# and keep it stable: changing it signs everyone out.
SESSION_SECRET=

# Voice chat (Agora). Leave both empty to run without voice.
# The certificate is a secret: it stays on the backend and must never be given a VITE_ name.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Frontend: where the browser finds the backend. Empty means this host on port 3001.
VITE_SERVER_URL=
