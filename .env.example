# Copy to .env to override the defaults. Everything works locally without this file.

# Backend
PORT=3001
# Address to bind. 127.0.0.1 keeps it on this machine; 0.0.0.0 lets other devices on the network connect.
HOST=127.0.0.1
# Comma-separated frontend origins allowed to connect. Empty allows any origin, which is fine locally.
CLIENT_ORIGIN=
# Folder that holds world.json.
DATA_DIR=data

# Frontend: where the browser finds the backend. Empty means this host on port 3001.
VITE_SERVER_URL=
